@startuml physical_layout
hide empty members
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "PK = USER#{sub}   (read: list my Maps, authorize a write)" {
  class "SK = PROFILE" as U1 {
    createdAt
  }
  class "SK = MEMBER#{rootMapId}" as U2 {
    role
    joinedAt
  }
}

package "PK = MAP#{mapId}   (ONE Query = open a Map: tiles only)" {
  class "SK = META" as M1 {
    name (root only)
    nodeCount
    viewCount
    visibility (root only)
    publishedAt (only while public)
    GSI1PK, GSI1SK (only while public)
  }
  class "SK = VIEW#{viewId}" as M2 {
    name
    order
    linkCount
  }
  class "SK = NODE#{shortId}   (tile)" as M3 {
    title
    date
    size
    positions
    coverImage
    preview
    excerpt
    childCount
    imageCount
    hasArticle
  }
  class "SK = LINK#{viewId}#{lo}#{hi}" as M4 {
    type
    label
  }
}

package "PK = CONTENT#{nodeId}   (ONE Query = open a node)" {
  class "SK = DETAIL" as C1 {
    body
    note
    urls
    images
  }
  class "SK = ARTICLE" as C2 {
    markdown
  }
}

package "GSI1 (sparse): GSI1PK = MAP#PUBLIC   (gallery: newest-published first, no Scan)" {
  class "GSI1SK = {publishedAt}#{mapId}" as G1 {
    name (projected)
    only public Maps
  }
}

package "PK = MAP#ALL   (constant key: ops list of all Maps, no Scan)" {
  class "SK = MAP#{rootMapId}" as D1 {
    ownerSub
    createdAt
    immutable pointer
  }
}

M3 ..> C1 : full text and links,\nfetched on open
M3 ..> C2 : only when hasArticle
U2 ..> M1 : root Map\n(nested Map id = node id)
D1 ..> M1 : name lives in META only
M1 ..> G1 : index entry exists\nonly while public
@enduml
