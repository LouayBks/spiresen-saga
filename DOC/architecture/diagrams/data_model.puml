@startuml data_model
hide empty members
skinparam classAttributeIconSize 0
left to right direction

enum Role {
  owner
  editor
  viewer
}
enum Visibility {
  private
  unlisted
  public
}
enum LinkType {
  theme
  timeline
  soft
}

class User {
  sub : string
  createdAt : datetime
}
class Membership {
  role : Role
  joinedAt : datetime
}
class Map {
  id : string
  name : string [0..1] "root only"
  visibility : Visibility "root only, default private"
  publishedAt : datetime [0..1] "only while public"
  nodeCount : int "max 50"
  viewCount : int "1..3"
}
class View {
  id : string
  name : string
  order : string "fractional"
  linkCount : int "max 100"
}
class Node {
  id : string "parentMapId.shortId"
  title : string
  body : string "info text"
  date : string
  size : Size
  positions : Map<viewId, Position>
  --derived, drive inference--
  childCount : int
  imageCount : int
  hasArticle : bool
  --attachments, any node--
  note : string [0..1]
  urls : string [*]
  preview : Preview [0..1]
  coverImage : string [0..1]
}
class Size {
  w : int "grid units"
  h : int "grid units"
}
class Position {
  x : float "grid units"
  y : float "grid units"
}
class Link {
  nodeA : string "sorted pair"
  nodeB : string "sorted pair"
  type : LinkType
  label : string [0..1]
}
class Gallery {
  images : Image [1..10]
}
class Article {
  markdown : string
}
class Image {
  s3Key : string
  caption : string [0..1]
}
class Preview {
  url : string
  thumbnailUrl : string
  title : string
}

note "Primary content: at most ONE of\nGallery / Article / nested Map (CON-8).\nNo stored kind: the UI infers the\nvisualization from what exists (CON-7)." as XOR
note "A View is grid when it has no Links,\nfreeform when it has at least one.\nDerived at render time, never stored." as LAYOUT

User "1" --> "*" Membership
Membership "*" --> "1" Map : root maps only
Map "1" *-- "1..3" View
Map "1" *-- "0..50" Node
View "1" *-- "0..100" Link
Link "*" --> "2" Node : endpoints, undirected
Node "1" *-- "1" Size
Node "1" *-- "*" Position : one per view
Node "1" o-- "0..1" Map : nested map (id = node id)
Node "1" *-- "0..1" Gallery
Node "1" *-- "0..1" Article
Gallery *-- Image
Node *-- Preview
Map .. XOR
Gallery .. XOR
Article .. XOR
View .. LAYOUT
Membership ..> Role
Map ..> Visibility
Link ..> LinkType
@enduml
